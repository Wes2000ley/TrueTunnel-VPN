#include <windows.h>
#include <winver.h>
#define IDI_VPN_ICON 101

IDI_VPN_ICON ICON "vpn.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,1,0,0
 PRODUCTVERSION 3,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L       // VOS__WINDOWS32
 FILETYPE 0x1L         // VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "TrueTunnel Project"
      VALUE "FileDescription",  "TrueTunnel secure IPv4 VPN for Windows"
      VALUE "FileVersion",      "3.1.0-dev"
      VALUE "InternalName",     "truetunnel"
      VALUE "LegalCopyright",   "Copyright (c) 2025-2026 Wesley Atwell"
      VALUE "LegalTrademarks",  "TrueTunnel: MIT/GPLv2; bundled wolfSSL: GPLv3 or commercial"
      VALUE "OriginalFilename", "TrueTunnel.exe"
      VALUE "ProductName",      "TrueTunnel"
      VALUE "ProductVersion",   "3.1.0-dev"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
